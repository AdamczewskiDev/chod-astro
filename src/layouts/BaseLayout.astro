---
import { site, meta } from '../data/content';
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.description } = Astro.props;

const siteUrl = site.baseUrl;
const ogImage = `${siteUrl}/og.webp`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.brand,
  description: meta.description,
  telephone: site.phone,
  email: site.email,
  areaServed: 'PL',
  url: `${siteUrl}/`,
  sameAs: [`${siteUrl}/`],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#121212" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('chod-theme');
          var theme = stored === 'dark' || stored === 'light' ? stored : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={`${siteUrl}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/theme.ts';
      import '../scripts/main.ts';
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
