---
import Logo from './Logo.astro';
import { site, navigation } from '../data/content';
---

<header class="top-bar">
  <div class="container header-inner">
    <Logo />
    <nav class="main-nav" aria-label="Menu główne">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a href={`tel:${site.phone}`} class="btn-call" title="Zadzwoń do nas teraz">
      ZADZWOŃ: {site.phoneDisplay}
    </a>
  </div>
</header>
