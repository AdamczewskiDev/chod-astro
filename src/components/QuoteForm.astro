---
import { quoteForm } from '../data/content';
---

<section id={quoteForm.id} class="container border-box mt-space" aria-labelledby="wycena-heading">
  <div class="section-header border-bottom">
    <h2 id="wycena-heading">{quoteForm.title}</h2>
  </div>
  <div class="content-padding">
    <form
      id="quote-form"
      class="quote-form"
      method="post"
      action="/api/quote"
      novalidate
    >
      <div class="form-grid">
        {/* Honeypot FormSubmit / lokalny — boty, które to wypełnią, są cicho odrzucane. */}
        <input
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          class="sr-only"
          aria-hidden="true"
        />
        {/* Drugi honeypot (tylko nasza walidacja) — łapie boty omijające _honey. */}
        <input
          type="text"
          name="website"
          id="q-website"
          tabindex="-1"
          autocomplete="off"
          class="sr-only"
          aria-hidden="true"
        />

        <div class="field">
          <label for="q-name">{quoteForm.fields.name.label}</label>
          <input
            id="q-name"
            name="name"
            type="text"
            autocomplete={quoteForm.fields.name.autocomplete}
            maxlength="120"
            placeholder={quoteForm.fields.name.placeholder}
            aria-describedby="q-name-error"
          />
          <p class="field-error" id="q-name-error" role="alert"></p>
        </div>
        <div class="field">
          <label for="q-email">{quoteForm.fields.email.label}</label>
          <input
            id="q-email"
            name="email"
            type="email"
            autocomplete={quoteForm.fields.email.autocomplete}
            maxlength="254"
            placeholder={quoteForm.fields.email.placeholder}
            aria-describedby="q-email-error"
          />
          <p class="field-error" id="q-email-error" role="alert"></p>
        </div>
        <div class="field">
          <label for="q-phone">{quoteForm.fields.phone.label}</label>
          <input
            id="q-phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete={quoteForm.fields.phone.autocomplete}
            maxlength="20"
            placeholder={quoteForm.fields.phone.placeholder}
            aria-describedby="q-phone-error"
          />
          <p class="field-error" id="q-phone-error" role="alert"></p>
        </div>
        <div class="field">
          <label for="q-date">{quoteForm.fields.date.label}</label>
          <input
            id="q-date"
            name="date"
            type="text"
            maxlength="60"
            placeholder={quoteForm.fields.date.placeholder}
          />
        </div>
        <div class="field field-full">
          <label for="q-msg">{quoteForm.fields.message.label}</label>
          <textarea
            id="q-msg"
            name="message"
            rows="5"
            placeholder={quoteForm.fields.message.placeholder}
            aria-describedby="q-msg-error"
          ></textarea>
          <p class="field-error" id="q-msg-error" role="alert"></p>
        </div>
        <div class="field field-full checkbox-row">
          <label class="checkbox">
            <input
              id="q-consent"
              name="consent"
              type="checkbox"
              aria-describedby="q-consent-error"
            />
            <span>{quoteForm.consentText}</span>
          </label>
          <p class="field-error" id="q-consent-error" role="alert"></p>
        </div>
        <div class="field field-full turnstile-field">
          <div
            id="cf-turnstile"
            class="cf-turnstile"
            data-sitekey={quoteForm.turnstileSiteKey}
            data-theme="auto"
            data-language="pl"
          ></div>
          <p class="field-error" id="q-turnstile-error" role="alert"></p>
        </div>
        <div class="field field-full">
          <button class="btn-solid" type="submit">{quoteForm.submitText}</button>
          <p class="form-hint" id="quote-status" role="status" aria-live="polite"></p>
          <noscript>
            <p class="form-hint">
              {quoteForm.noscriptText}
              <a href={`mailto:${quoteForm.email}`}>{quoteForm.email}</a>.
            </p>
          </noscript>
        </div>
      </div>
    </form>
  </div>
</section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
