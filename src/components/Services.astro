---
import { services } from '../data/content';
---

<section id={services.id} class="container border-box mt-space">
  <div class="section-header">
    <h2>{services.title.toUpperCase()}</h2>
  </div>
  <div class="content-padding services-content">
    <p class="services-intro">{services.intro}</p>
    <ul class="services-list">
      {services.list.map((item) => <li>{item}</li>)}
    </ul>
    <p class="services-closing">{services.closingNote}</p>
  </div>
</section>
