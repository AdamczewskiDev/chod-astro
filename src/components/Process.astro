---
import { process } from '../data/content';
---

<section id={process.id} class="container mt-space" aria-labelledby="process-heading">
  <div class="section-header border-box mb-space">
    <h2 id="process-heading">{process.title.toUpperCase()}</h2>
  </div>

  <ol class="process-list">
    {
      process.items.map((step) => (
        <li class="process-step border-box">
          <span class="process-number" aria-hidden="true">
            {step.step}
          </span>
          <div class="process-content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
