---
import { contacts, cta } from '../data/content';
---

<section id={cta.id} class="container mt-space" aria-labelledby="cta-heading">
  <div class="cta-layout">
    <div class="cta-box border-box content-padding">
      <h2 id="cta-heading">{cta.title}</h2>
      <p>{cta.lead}</p>
      <a href={cta.ctaHref} class="btn-solid btn-solid--accent-inverse" title="Przejdź do formularza wyceny">
        {cta.ctaText}
      </a>
    </div>
    <aside class="cta-side-notes" aria-label="Szybki kontakt">
      <div class="cta-side-note border-box">
        <strong>{cta.contactsTitle}</strong>
        <ul class="contact-list">
          {
            contacts.map((person) => (
              <li class="contact-person">
                <a class="contact-phone" href={`tel:${person.phone}`}>{person.phoneDisplay}</a>
                <span class="contact-name">
                  {person.name} — {person.role}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</section>
