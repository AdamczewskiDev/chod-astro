---
import { clients } from '../data/content';
---

<section id={clients.id} class="container mt-space" aria-labelledby="clients-heading">
  <div class="section-header border-box mb-space">
    <h2 id="clients-heading">{clients.title}</h2>
  </div>

  <div class="clients-marquee" role="region" aria-label={clients.title}>
    <div class="clients-track">
      <ul class="clients-set">
        {
          clients.items.map((client) => (
            <li class="client-card border-box">
              <img src={client.logo} alt="" loading="lazy" decoding="async" width="96" height="96" />
              <span class="client-name">{client.name}</span>
            </li>
          ))
        }
      </ul>
      <ul class="clients-set" aria-hidden="true">
        {
          clients.items.map((client) => (
            <li class="client-card border-box">
              <img src={client.logo} alt="" loading="lazy" decoding="async" width="96" height="96" />
              <span class="client-name">{client.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
