---
import { site, portfolio } from '../data/content';
---

<section id={portfolio.id} class="container mt-space" aria-labelledby="portfolio-heading">
  <div class="section-header border-box mb-space">
    <h2 id="portfolio-heading">{portfolio.title}</h2>
  </div>

  <div class="grid-3">
    {
      portfolio.items.map((item) => (
        <article class="portfolio-card border-box">
          <div class="portfolio-thumb">
            {item.image ? (
              <img src={item.image} alt={item.title} loading="lazy" decoding="async" />
            ) : (
              <span class="portfolio-thumb-label" aria-hidden="true">{item.category}</span>
            )}
          </div>
          <div class="content-padding">
            <span class="portfolio-category">{item.category}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <ul class="portfolio-tags">
              {item.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            {item.date ? <p class="portfolio-date">{item.date}</p> : null}
          </div>
        </article>
      ))
    }
  </div>

  {/* Tymczasowo ukryte — wróci, gdy będą linki do FB i Instagrama.
  <p class="portfolio-social-note text-center mt-space">
    {portfolio.socialPrefix}{' '}
    {
      site.facebook ? (
        <a href={site.facebook} rel="noopener noreferrer" target="_blank">
          {portfolio.facebookLabel}
        </a>
      ) : (
        <span>{portfolio.facebookLabel}</span>
      )
    }
    {' / '}
    {
      site.instagram ? (
        <a href={site.instagram} rel="noopener noreferrer" target="_blank">
          {portfolio.instagramLabel}
        </a>
      ) : (
        <span>{portfolio.instagramLabel}</span>
      )
    }
  </p>
  */}
</section>
